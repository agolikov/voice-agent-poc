# --- ElevenLabs -------------------------------------------------------------
# Server-side only. Never expose to the browser: the client receives a short-lived
# conversation token minted by /api/conversation-token instead.
ELEVENLABS_API_KEY=
# The agent created from agent/agent_configs/roleplay-tutor.json (`pnpm agent:push`).
ELEVENLABS_AGENT_ID=
# From the agent's post-call webhook settings. Used to verify the HMAC signature.
ELEVENLABS_WEBHOOK_SECRET=

# --- Scenario generation ----------------------------------------------------
# Any OpenAI-compatible endpoint, or leave AI_BASE_URL empty to use Anthropic directly.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# The model that reads a photo the learner attaches to a situation. Must be
# vision-capable; unset, AI_MODEL is asked to look, which is right for Anthropic
# and wrong for a text-only endpoint. On Nebius: Qwen/Qwen2.5-VL-72B-Instruct.
AI_VISION_MODEL=

# --- Storage ----------------------------------------------------------------
# Postgres. Any cluster will do: a local one for development, a managed one in
# production. Use sslmode=verify-full for a hosted provider and sslmode=disable
# for a plaintext instance on a private network.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callmode
# Sockets this process may open. Several app instances may share one database,
# and pooled providers count every socket against the plan.
DATABASE_POOL_MAX=5

# --- Site access ------------------------------------------------------------
# One shared code in front of the whole site. Not an account system: every
# visitor is the same anonymous user, they just have to know the code.
# Leave empty to run the site open, which is what local development wants.
# Changing it invalidates every session already unlocked. Keep it URL-safe so
# the ?key= share link works: `openssl rand -hex 12`.
SITE_PASSCODE=
